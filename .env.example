# External nginx origin; use HTTPS for any remote deployment.
PM_PUBLIC_URL=http://localhost:8088
# Google Console: Web application. Callback: ${PM_PUBLIC_URL}/api/auth/google/callback
PM_GOOGLE_CLIENT_ID=
PM_GOOGLE_CLIENT_SECRET=
# IDs from the account/session response. Local emails alone cannot grant admin.
PM_ADMIN_USER_IDS=
# Only emails verified by Google's provider can match this allowlist.
PM_ADMIN_GOOGLE_EMAILS=
# At least 32 random bytes/chars. Set out of band, never commit or bundle into frontend.
PM_ADMIN_DEVICE_KEY=
# Raw TCP is disabled unless configured. Not exposed by compose.
PM_TCP_ADDR=
PM_TCP_KEY=
PM_TCP_TLS_CERT=
PM_TCP_TLS_KEY=
